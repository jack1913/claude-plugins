{
  "permissions": {
    "allow": [
      "Bash(git fetch)",
      "PowerShell(git fetch)",
      "Bash(git fetch origin)",
      "PowerShell(git fetch origin)",
      "Bash(git switch:*)",
      "PowerShell(git switch:*)",
      "Bash(git stash push:*)",
      "PowerShell(git stash push:*)",
      "Bash(git stash list:*)",
      "PowerShell(git stash list:*)",
      "Bash(git stash show:*)",
      "PowerShell(git stash show:*)",
      "Bash(git worktree add:*)",
      "PowerShell(git worktree add:*)",
      "Bash(git worktree list:*)",
      "PowerShell(git worktree list:*)",
      "Bash(git remote -v)",
      "PowerShell(git remote -v)",
      "Bash(git remote show:*)",
      "PowerShell(git remote show:*)",
      "Bash(git remote get-url:*)",
      "PowerShell(git remote get-url:*)",
      "Bash(mkdir:*)",
      "PowerShell(mkdir:*)",
      "Bash(uv run ruff:*)",
      "PowerShell(uv run ruff:*)",
      "Bash(ruff check:*)",
      "PowerShell(ruff check:*)",
      "Bash(ruff format --check:*)",
      "PowerShell(ruff format --check:*)",
      "Bash(pip list:*)",
      "PowerShell(pip list:*)",
      "Bash(pip show:*)",
      "PowerShell(pip show:*)"
    ],
    "ask": [
      "Bash(git rm:*)",
      "PowerShell(git rm:*)",
      "Bash(git switch --discard-changes:*)",
      "PowerShell(git switch --discard-changes:*)",
      "Bash(git switch -f:*)",
      "PowerShell(git switch -f:*)",
      "Bash(git switch --force:*)",
      "PowerShell(git switch --force:*)",
      "Bash(npm install:*)",
      "PowerShell(npm install:*)",
      "Bash(npm i:*)",
      "PowerShell(npm i:*)",
      "Bash(npm add:*)",
      "PowerShell(npm add:*)",
      "Bash(npm uninstall:*)",
      "PowerShell(npm uninstall:*)",
      "Bash(uv add:*)",
      "PowerShell(uv add:*)",
      "Bash(uv remove:*)",
      "PowerShell(uv remove:*)",
      "Bash(uv lock:*)",
      "PowerShell(uv lock:*)",
      "Bash(pip install:*)",
      "PowerShell(pip install:*)",
      "Bash(pip uninstall:*)",
      "PowerShell(pip uninstall:*)",
      "Bash(poetry add:*)",
      "PowerShell(poetry add:*)",
      "Bash(poetry remove:*)",
      "PowerShell(poetry remove:*)",
      "Bash(poetry update:*)",
      "PowerShell(poetry update:*)",
      "Bash(alembic upgrade:*)",
      "PowerShell(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "PowerShell(alembic downgrade:*)",
      "Bash(python manage.py migrate:*)",
      "PowerShell(python manage.py migrate:*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Read(**/.pypirc)",
      "Edit(**/.pypirc)",
      "Read(**/pip.conf)",
      "Edit(**/pip.conf)",
      "Read(**/uv.toml)",
      "Edit(**/uv.toml)"
    ],
    "deny": [
      "Bash(git reset:*)",
      "PowerShell(git reset:*)",
      "Bash(git restore:*)",
      "PowerShell(git restore:*)"
    ]
  }
}
