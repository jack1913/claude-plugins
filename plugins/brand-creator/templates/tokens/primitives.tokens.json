    "$type": "dimension",
    "$description": "Viewport widths where the layout changes. These are proposals until G4: the owner approves or changes them with the layout rules.",
    "sm": {
      "$value": {
        "value": 640,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 768,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 1024,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 1280,
        "unit": "px"
      }
    }
  },
  "leading": {
    "$type": "number",
    "$description": "Line height as a unitless multiple of the font size. These are proposals until G4: the owner approves or changes them with the type rules.",
    "display": {
      "$value": 1.1
    },
    "body": {
      "$value": 1.5
    }
  },
  "tracking": {
    "$type": "number",
    "$description": "Letter spacing in em: letter-spacing: calc(var(--tracking-display) * 1em). These are proposals until G4: the owner approves or changes them with the type rules.",
    "display": {
      "$value": -0.01
    },
    "body": {
      "$value": 0
    }
  },
  "motion": {
    "$type": "duration",
    "$description": "Named durations; reduced motion means none of them run.",
    "quick": {
      "$value": {
        "value": 160,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 320,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 640,
        "unit": "ms"
      }
    },
    "stagger": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Named curves as [x1, y1, x2, y2], x1 and x2 between 0 and 1. These three are proposals until G4: the owner approves or changes them with the motion rules.",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    }
  }
}
