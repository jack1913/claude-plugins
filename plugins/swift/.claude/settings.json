{
  "permissions": {
    "allow": [
      "Bash(git fetch)",
      "PowerShell(git fetch)",
      "Bash(git fetch origin)",
      "PowerShell(git fetch origin)",
      "Bash(git switch:*)",
      "PowerShell(git switch:*)",
      "Bash(git stash:*)",
      "PowerShell(git stash:*)",
      "Bash(git remote:*)",
      "PowerShell(git remote:*)",
      "Bash(mkdir:*)",
      "PowerShell(mkdir:*)"
    ],
    "ask": [
      "Bash(git rm:*)",
      "PowerShell(git rm:*)",
      "Read(**/.env*)",
      "Edit(**/.env*)"
    ],
    "deny": [
      "Bash(git reset:*)",
      "PowerShell(git reset:*)",
      "Bash(git restore:*)",
      "PowerShell(git restore:*)"
    ]
  }
}
